# Shopify
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_WEBHOOK_SECRET=replace_with_a_long_random_secret
SHOPIFY_API_VERSION=2026-04
SHOPIFY_BILLING_TEST=true

# App
APP_URL=https://postlift-api-production.up.railway.app
CORS_ORIGINS=https://postlift-api-production.up.railway.app,http://localhost:5000
RUN_SCHEDULER=true

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database
DATABASE_URL=postgresql://postlift:postlift@localhost:5432/postlift

# Email reports
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=reports@your-app.example.com
